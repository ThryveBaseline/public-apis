//@version=5
// Fair Pricing Theory (JJ Simon) - NQ 1-minute continuation / reversion signals
// Reconstructed from public descriptions; see ../docs/DOSSIER.md for sources and
// ../docs/ASSUMPTIONS.md for the choices made where the public record is silent.
// Apply to NQ1! on the 1-minute chart with the chart timezone set to America/New_York.
// Parity with fpt/strategy.py: defaults match StrategyConfig as aligned to his own words
// (5-minute continuation, 14:00-15:00 PM window, his displacement definition, 1-candle swings,
// continuation in the opening candle's direction, the 25/38 bracket, the 0.8 x target room
// rule for reversions, 25-point big-open rule on the continuation trade, any close through the
// latest swing consumes it). The three-losses-per-session stop and the no-maximum trade count
// are backtester state the indicator cannot hold. Known differences: this indicator marks EVERY
// qualifying bar, while the backtester holds one position at a time, caps trades per day
// and applies daily stops, so it takes only the first signal not overlapping an open trade;
// the backtester also keeps a list of swings and uses the most recent unbroken one within
// the lookback, whereas this script tracks only the latest swing. StrategyConfig options with
// NO counterpart here: anchor (close_0929 / vwap_0929_0930), rolling_fair_value, extra_sessions
// (08:30, 18:00, 20:00), skip_first_minutes, reversion_end, min_distance_from_fv, stop_scope,
// target_points. Run parity checks with the Python defaults only.
indicator("Fair Pricing Theory - NQ (replication)", overlay=true, max_lines_count=500, max_labels_count=500)

// ---------------- inputs ----------------
sessStart   = input.session("0930-1100", "Trading window (NY)")
contWindow  = input.session("0930-0935", "Continuation window (NY)", tooltip="ASSUMPTIONS.md row 2: JJ ~5 minutes; fxreplay 10-15 (0930-0945). Clock-based like the backtester, so a missing bar does not shift the phase")
pmSession   = input.bool(false, "Also trade the 14:00 session")
pmStart     = input.session("1400-1500", "PM window (NY)")
pmContWindow = input.session("1400-1405", "PM continuation window (NY)")
bigOpenPts  = input.float(25.0, "Big opening candle (points), 0 = off", tooltip="ASSUMPTIONS.md row 21: 09:30 range above this -> 50pt stop at half size")
bandPts     = input.float(38.0, "Premium/discount band (points)")
requireBand = input.bool(false, "Reversion only after band touch")
atrLen      = input.int(14, "ATR length (1-min)")
wickPct     = input.float(0.20, "Max counter-wick as fraction of open-to-extreme", step=0.05)
dispMode    = input.string("jj", "Displacement rule", options=["jj", "wick"], tooltip="jj: body larger than the previous candle's body and close beyond it (his definition); wick: fxreplay's 20% counter-wick test plus the ATR body filter")
minBodyATR  = input.float(0.5, "Min displacement body (x ATR), wick mode", step=0.25, tooltip="ASSUMPTIONS.md row 6")
swingLen    = input.int(1, "Swing left/right bars", tooltip="JJ: a wick lower/higher than the one candle before and after; fxreplay-style pivots: 3")
contByOpen  = input.bool(true, "Continuation in the opening candle's direction", tooltip="off = side of fair value")
useATRTiers = input.bool(false, "Use fxreplay ATR stop tiers", tooltip="off = his fixed bracket below")
fixedStop   = input.float(25.0, "Fixed stop (points)")
fixedTarget = input.float(38.0, "Fixed target (points)")
roomPct     = input.float(0.8, "Reversion room: distance to fair value >= this x target (0 = off)", step=0.05)
lookback    = input.int(60, "Structure lookback (bars)")
allowGradeA = input.bool(true, "Take grade-A (displacement only) signals")
rr          = input.float(1.5, "Target R multiple")
tier1ATR    = input.float(20.0, "Tier 1: ATR above -> 50pt stop / 1 ct")
tier2ATR    = input.float(7.0,  "Tier 2: ATR above -> 25pt stop / 2 ct (else 16.5pt / 3 ct)")

// ---------------- session / fair value ----------------
inAM = not na(time(timeframe.period, sessStart, "America/New_York"))
inPM = pmSession and not na(time(timeframe.period, pmStart, "America/New_York"))
newAM = inAM and not inAM[1]
newPM = inPM and not inPM[1]
var float fv = na
if newAM
    fv := open
if newPM
    fv := open
inWindow = inAM or inPM
inContAM = inAM and not na(time(timeframe.period, contWindow, "America/New_York"))
inContPM = inPM and not na(time(timeframe.period, pmContWindow, "America/New_York"))
isCont = inContAM or inContPM
var float dayHigh = na
var float dayLow  = na
if newAM or newPM
    dayHigh := high
    dayLow  := low
else if inAM or inPM
    dayHigh := math.max(dayHigh, high)
    dayLow  := math.min(dayLow, low)
var float openRange = na
if newAM
    openRange := high - low
var int openDir = 0
var float openBody = na
if newAM or newPM
    openDir := close > open ? 1 : close < open ? -1 : 0
    openBody := math.abs(close - open)
bigOpen = isCont and bigOpenPts > 0 and openBody > bigOpenPts

// ---------------- ATR tier ----------------
atrV = ta.atr(atrLen)
tierStop = atrV > tier1ATR ? 50.0 : atrV >= tier2ATR ? 25.0 : 16.5
tierCts  = atrV > tier1ATR ? 1 : atrV >= tier2ATR ? 2 : 3
baseStop = useATRTiers ? tierStop : fixedStop
baseCts  = useATRTiers ? tierCts : 1
stopPts  = bigOpen ? 50.0 : baseStop
tgtPts   = bigOpen ? rr * 50.0 : (useATRTiers ? rr * baseStop : fixedTarget)
cts      = bigOpen ? math.max(1, math.floor(baseCts / 2)) : baseCts

// ---------------- displacement ----------------
bullWick = close > open and (high - open) > 0 and (high - close) <= wickPct * (high - open) and (close - open) >= minBodyATR * atrV
bearWick = close < open and (open - low) > 0 and (close - low) <= wickPct * (open - low) and (open - close) >= minBodyATR * atrV
prevBody = math.abs(close[1] - open[1])
bullJJ = close > open and (close - open) > prevBody and close > high[1]
bearJJ = close < open and (open - close) > prevBody and close < low[1]
bullDisp = dispMode == "jj" ? bullJJ : bullWick
bearDisp = dispMode == "jj" ? bearJJ : bearWick

// ---------------- structure (confirmed pivots only) ----------------
// Pivot rule written out so it matches fpt/indicators.swing_points exactly: the centre bar is the
// unique extreme of the (2 * swingLen + 1)-bar window (a tie on either side is not a pivot).
// ta.pivothigh's own tie handling is not documented, so it is not used.
f_unique_pivot(src, len, isHigh) =>
    centre = src[len]
    ext = isHigh ? ta.highest(src, 2 * len + 1) : ta.lowest(src, 2 * len + 1)
    cnt = 0
    for i = 0 to 2 * len
        cnt += src[i] == centre ? 1 : 0
    centre == ext and cnt == 1 ? centre : na
ph = f_unique_pivot(high, swingLen, true)
pl = f_unique_pivot(low, swingLen, false)
var float lastPH = na
var int   lastPHbar = na
var float lastPL = na
var int   lastPLbar = na
if newAM
    lastPH := na
    lastPL := na
if not na(ph)
    lastPH := ph
    lastPHbar := bar_index - swingLen
if not na(pl)
    lastPL := pl
    lastPLbar := bar_index - swingLen
bosUp   = not na(lastPH) and bar_index - lastPHbar <= lookback and close > lastPH
bosDown = not na(lastPL) and bar_index - lastPLbar <= lookback and close < lastPL
if bosUp
    lastPH := na
if bosDown
    lastPL := na

// ---------------- direction logic ----------------
above = close > fv
contDir = contByOpen ? openDir : (above ? 1 : -1)
dirWanted = isCont ? contDir : (above ? -1 : 1)
bandOK = not requireBand or isCont or (dirWanted == -1 ? dayHigh >= fv + bandPts : dayLow <= fv - bandPts)
roomOK = isCont or roomPct <= 0 or math.abs(close - fv) >= roomPct * tgtPts
longSig  = inWindow and not na(fv) and close != fv and dirWanted == 1  and bullDisp and bandOK and roomOK and (bosUp   or allowGradeA)
shortSig = inWindow and not na(fv) and close != fv and dirWanted == -1 and bearDisp and bandOK and roomOK and (bosDown or allowGradeA)
gradeLong  = bosUp ? "A+" : "A"
gradeShort = bosDown ? "A+" : "A"

// ---------------- plots ----------------
plot(inWindow ? fv : na, "Fair value", color=color.new(color.yellow, 0), linewidth=2, style=plot.style_linebr)
plot(inWindow ? fv + bandPts : na, "Premium edge", color=color.new(color.red, 60), style=plot.style_linebr)
plot(inWindow ? fv - bandPts : na, "Discount edge", color=color.new(color.green, 60), style=plot.style_linebr)
bgcolor(isCont ? color.new(color.blue, 92) : inWindow ? color.new(color.gray, 94) : na)
plotshape(longSig,  "Long",  style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.small, text="")
plotshape(shortSig, "Short", style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.small, text="")
if longSig
    label.new(bar_index, low, (isCont ? "C " : "R ") + gradeLong + "\n" + str.tostring(cts) + "x SL " + str.tostring(stopPts) + " TP " + str.tostring(tgtPts), style=label.style_label_up, color=color.new(color.green, 70), textcolor=color.white, size=size.tiny)
if shortSig
    label.new(bar_index, high, (isCont ? "C " : "R ") + gradeShort + "\n" + str.tostring(cts) + "x SL " + str.tostring(stopPts) + " TP " + str.tostring(tgtPts), style=label.style_label_down, color=color.new(color.red, 70), textcolor=color.white, size=size.tiny)
alertcondition(longSig,  "FPT long",  "FPT long signal")
alertcondition(shortSig, "FPT short", "FPT short signal")
